+// Card click: run the live default action (opens the chat etc.), then focus the sender's window.
+void NotificationsTab::activateNotificationEntry(const NotificationHistoryEntry& entry) {
+  // Copy first: invoking the action can drop the history entry.
+  const uint32_t id = entry.notification.id;
+  const std::string idLower =
+      StringUtils::toLower(entry.notification.desktopEntry.value_or(entry.notification.appName));
+  bool hasDefault = false;
+  for (std::size_t i = 0; i + 1 < entry.notification.actions.size(); i += 2) {
+    hasDefault = hasDefault || entry.notification.actions[i] == "default";
+  }
+
+  if (hasDefault) {
+    invokeNotificationAction(id, "default");
+  }
+  if (m_platform != nullptr) {
+    if (const auto windows = m_platform->enrichedWindowsForApp(idLower, idLower); !windows.empty()) {
+      m_platform->activateToplevelInfo(windows.back());
+    }
+  }
+  PanelManager::instance().close();
+}
